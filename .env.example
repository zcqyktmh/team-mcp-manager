# 推荐通过后台「集成登录」配置，服务端保存到 data/auth-settings.json，重启生效。
# 默认云之家网站扫码 qr；工作台免登可选 ticket；企业自供 OAuth 可选 oauth-code。
CLOUD_HOME_LOGIN_MODE=qr
CLOUD_HOME_ENTERPRISE_ID=
CLOUD_HOME_CLIENT_ID=
CLOUD_HOME_CLIENT_SECRET=
# 公司 HTTPS 管理器域名 + /auth/cloud-home/entry，同步登记为云之家轻应用访问地址。
CLOUD_HOME_REDIRECT_URI=
# 公有云官方接口，私有部署以企业文档为准。
CLOUD_HOME_TOKEN_URL=https://www.yunzhijia.com/gateway/oauth2/token/getAccessToken
CLOUD_HOME_USERINFO_URL=https://www.yunzhijia.com/gateway/ticket/user/acquirecontext
# 首位管理员需核验企业成员 openid 与手机号；ticket 不保证返回手机号。
MCP_MANAGER_BOOTSTRAP_ADMIN_OPENID=
MCP_MANAGER_BOOTSTRAP_ADMIN_ACCOUNT=
MCP_MANAGER_BOOTSTRAP_ADMIN_PHONE=
MCP_MANAGER_BOOTSTRAP_ADMIN_NAME=
# 以下仅用于企业另行提供的通用 OAuth 授权码协议。
CLOUD_HOME_AUTHORIZATION_URL=
CLOUD_HOME_SCOPES=
CLOUD_HOME_TOKEN_AUTH_METHOD=client_secret_post
CLOUD_HOME_SUBJECT_PATH=userId
CLOUD_HOME_PHONE_PATH=mobile
CLOUD_HOME_ACCOUNT_PATH=account
CLOUD_HOME_NAME_PATH=name
