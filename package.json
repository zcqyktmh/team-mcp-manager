{
  "name": "team-mcp-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "build:win": "pkg . --targets node24-win-x64 --output dist/TeamMcpManager.exe",
    "build:linux": "pkg . --targets node24-linux-x64,node24-linux-arm64 --out-path dist",
    "build:mac": "pkg . --targets node24-macos-x64,node24-macos-arm64 --out-path dist",
    "build:all": "pkg ."
  },
  "pkg": {
    "targets": [
      "node24-win-x64",
      "node24-linux-x64",
      "node24-linux-arm64",
      "node24-macos-x64",
      "node24-macos-arm64"
    ],
    "assets": [
      "public/**/*"
    ],
    "outputPath": "dist",
    "bytecode": false,
    "public": true,
    "publicPackages": "*"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0"
  }
}

